---
import BaseLayout from '../layouts/BaseLayout.astro'; import ServiceCards from '../components/ServiceCards.astro'; import ProjectGrid from '../components/ProjectGrid.astro';
---
<BaseLayout title="Engineering Power. Enabling Progress." description="SJ Powertech Pvt. Ltd. provides electrical contracting, smart metering, power infrastructure and skilled manpower solutions in Agra, Uttar Pradesh.">
 <section class="relative isolate min-h-[590px] overflow-hidden bg-navy text-white"><img src="/images/hero.png" alt="SJ Powertech engineering work" class="absolute inset-0 -z-20 h-full w-full object-cover object-center" fetchpriority="high"/><div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(11,35,68,.96),rgba(11,35,68,.76),rgba(11,35,68,.25))]"></div><div class="shell grid min-h-[590px] items-center py-20"><div class="reveal"><p class="eyebrow">Powering India's ambition</p><h1 class="mt-3 max-w-3xl font-display text-5xl leading-[1.03] md:text-7xl">Engineering power.<br/><span class="text-gold">Enabling progress.</span></h1><p class="mt-6 max-w-xl text-lg text-white/85">From complex electrical systems to intelligent industrial automation, SJ Powertech turns technical ambition into durable performance.</p><div class="mt-8 flex flex-wrap gap-3"><a class="btn btn-gold" href="/contact">Start a conversation →</a><a class="btn btn-outline" href="/projects">Explore our work</a></div></div></div></section>
 <section class="shell grid gap-8 py-16 md:grid-cols-[.8fr_1.2fr] md:py-24"><div class="reveal"><p class="eyebrow">Who we are</p><h2 class="heading">Built on precision. Driven by partnership.</h2><a href="/about" class="btn btn-gold mt-3">Discover SJ Powertech</a></div><p class="reveal max-w-xl text-lg text-slate-600">We are an engineering partner for organizations that cannot compromise on quality, safety or continuity. Our multidisciplinary team delivers practical, future-ready solutions at every stage of the project lifecycle.</p></section>
 <section class="bg-white py-20"><div class="shell"><p class="eyebrow">Capabilities</p><h2 class="heading max-w-2xl">Solutions that keep business moving.</h2><ServiceCards/></div></section>
 <section class="bg-navy py-20 text-white"><div class="shell grid gap-8 md:grid-cols-4">{[['250+','Projects delivered'],['15+','Industry segments'],['98%','Repeat partnerships'],['24/7','Support mindset']].map(([n,l]) => <div class="reveal border-l border-gold pl-5"><strong class="font-display text-4xl text-gold">{n}</strong><p class="mt-1 text-sm text-white/70">{l}</p></div>)}</div></section>
 <section class="shell py-20"><div class="mb-10 flex flex-wrap items-end justify-between gap-4"><div><p class="eyebrow">Featured projects</p><h2 class="heading">Work that speaks for itself.</h2></div><a class="font-bold text-navy hover:text-gold" href="/projects">View all projects →</a></div><ProjectGrid/></section>
 <section class="overflow-hidden bg-white py-16"><div class="shell"><p class="text-center text-xs font-bold uppercase tracking-[.2em] text-slate-400">Trusted across Power Infra</p><div class="mx-auto mt-8 grid max-w-4xl items-center gap-6 sm:grid-cols-2 lg:grid-cols-4"><div class="flex h-32 items-center justify-center rounded border border-slate-100 bg-white p-5 shadow-sm"><img src="/images/client-genus.jpg" alt="Genus" class="max-h-20 w-auto object-contain" loading="lazy"/></div><div class="flex h-32 items-center justify-center rounded border border-slate-100 bg-white p-5 shadow-sm"><img src="/images/client-gmr.png" alt="GMR Group" class="max-h-20 w-auto object-contain" loading="lazy"/></div><div class="flex h-32 items-center justify-center rounded border border-slate-100 bg-white p-5 shadow-sm"><img src="/images/client-dvvnl.jfif" alt="Dakshinanchal Vidyut Vitran Nigam Limited" class="max-h-20 w-auto object-contain" loading="lazy"/></div><div class="flex h-32 items-center justify-center rounded border border-slate-100 bg-white p-5 shadow-sm"><img src="/images/client-torrent-power.png" alt="Torrent Power" class="max-h-20 w-auto object-contain" loading="lazy"/></div></div></div></section>
 <section class="bg-gold py-16"><div class="shell flex flex-col items-start justify-between gap-5 md:flex-row md:items-center"><div><p class="text-sm font-bold uppercase tracking-widest text-navy/65">Let’s build what’s next</p><h2 class="mt-2 font-display text-3xl text-navy">Bring us your next engineering challenge.</h2></div><a class="btn bg-navy text-white hover:bg-navy/90" href="/contact">Request a consultation →</a></div></section>
</BaseLayout>
