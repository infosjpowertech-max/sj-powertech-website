---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro';
---
<BaseLayout title="Contact" description="Contact SJ Powertech to discuss your next engineering project."><PageHero title="Let’s start with a conversation." text="Tell us what you are building, improving or solving."/><section class="shell grid gap-10 py-20 md:grid-cols-[1.15fr_.85fr]"><form class="reveal bg-white p-7 shadow-sm" action="#" method="post"><div class="grid gap-5 sm:grid-cols-2"><label>Full name<input required name="name" autocomplete="name"/></label><label>Work email<input required type="email" name="email" autocomplete="email"/></label><label>Phone number<input name="phone" type="tel" autocomplete="tel"/></label><label>Area of interest<select name="interest"><option>Electrical Engineering</option><option>Industrial Automation</option><option>EPC & Infrastructure</option><option>Maintenance & Support</option></select></label></div><label class="mt-5 block">How can we help?<textarea required rows="5" name="message"></textarea></label><button class="btn btn-gold mt-5" type="submit">Send enquiry →</button><p class="mt-3 text-xs text-slate-500">This demonstration form is ready to connect to your preferred form endpoint.</p></form><aside class="reveal"><p class="eyebrow">Contact details</p><h2 class="heading">Here when you need us.</h2><p><b class="text-navy">Email</b><br/><a class="text-slate-600 hover:text-gold" href="mailto:info@sjpowertech.com">info@sjpowertech.com</a></p><p><b class="text-navy">Phone</b><br/><a class="text-slate-600 hover:text-gold" href="tel:+919876543210">+91 98765 43210</a></p><p><b class="text-navy">Office</b><br/><span class="text-slate-600">Industrial Area, India</span></p><div class="grid-pattern mt-7 grid h-52 place-items-center bg-navy text-center text-white"><div><span class="text-3xl text-gold">⌖</span><p class="m-1 text-sm">Google Maps location placeholder</p></div></div></aside></section></BaseLayout>
