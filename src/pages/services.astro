---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import ServiceCards from '../components/ServiceCards.astro';
---
<BaseLayout title="Services" description="Electrical engineering, industrial automation, EPC and maintenance solutions."><PageHero title="Technical depth. Practical delivery." text="Integrated engineering services tailored to the realities of your operation."/><section class="shell py-20"><ServiceCards/></section><section class="bg-white py-20"><div class="shell grid gap-8 md:grid-cols-2"><div><p class="eyebrow">Our process</p><h2 class="heading">Clear from scope to support.</h2></div><ol class="grid gap-4 sm:grid-cols-2">{[['01','Understand','Align technical requirements, risks and outcomes.'],['02','Engineer','Develop solutions built for performance and compliance.'],['03','Deliver','Execute with robust quality and safety controls.'],['04','Sustain','Support your assets through their full lifecycle.']].map(([n,t,d])=><li class="reveal list-none border-l-2 border-gold pl-4"><b class="text-gold">{n}</b><h3 class="text-lg text-navy">{t}</h3><p class="m-0 text-sm text-slate-600">{d}</p></li>)}</ol></div></section></BaseLayout>
