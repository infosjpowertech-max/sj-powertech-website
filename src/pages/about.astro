---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro';
---
<BaseLayout title="About Us" description="Learn about the people, values and engineering approach behind SJ Powertech."><PageHero title="Engineering confidence, project after project." text="A dependable technical partner for ambitious organizations."/><section class="shell grid gap-12 py-20 md:grid-cols-2"><div class="reveal"><p class="eyebrow">Our story</p><h2 class="heading">A practical approach to complex work.</h2><p class="text-slate-600">SJ Powertech Pvt. Ltd. brings together electrical, automation and project management specialists with one shared commitment: make every system safer, smarter and more dependable.</p><p class="text-slate-600">We work closely with clients from first concept through commissioning and beyond, combining rigorous execution with transparent communication.</p></div><div class="reveal relative min-h-96 overflow-hidden bg-navy"><img src="/images/about-team.png" alt="SJ Powertech team" class="absolute inset-0 h-full w-full object-cover" loading="lazy"/><div class="absolute inset-0 bg-navy/50"></div><div class="relative p-10 text-white"><p class="eyebrow">Our promise</p><blockquote class="mt-5 font-display text-3xl leading-snug">“Do the technical work thoroughly, and do the partnership work even better.”</blockquote></div></div></section><section class="bg-white py-20"><div class="shell"><p class="eyebrow">Our values</p><div class="mt-8 grid gap-5 md:grid-cols-3">{[['Safety without shortcuts','Every decision starts with people and protection.'],['Ownership in action','We take responsibility from scope to handover.'],['Quality that endures','We build systems that perform beyond commissioning.']].map(([t,d])=><article class="reveal border-t-4 border-gold p-6 shadow-sm"><h3 class="font-display text-2xl text-navy">{t}</h3><p class="mt-2 text-sm text-slate-600">{d}</p></article>)}</div></div></section></BaseLayout>
