---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Thank You" description="Thank you for contacting SJ Powertech.">
  <section class="grid-pattern bg-navy py-28 text-center text-white">
    <div class="shell max-w-2xl">
      <p class="eyebrow">Enquiry received</p>
      <h1 class="mt-3 font-display text-5xl">Thank you for getting in touch.</h1>
      <p class="mx-auto mt-5 max-w-xl text-lg text-white/80">Our team has received your enquiry and will respond as soon as possible.</p>
      <a class="btn btn-gold mt-8" href="/">Return to home</a>
    </div>
  </section>
</BaseLayout>
