---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const roles = [
  ['Project Engineer', 'Full time - India', 'Lead planning, coordination and technical delivery across active project sites.'],
  ['Automation Engineer', 'Full time - India', 'Design and commission PLC, SCADA and industrial control solutions.'],
  ['Site Supervisor', 'Full time - India', 'Champion safe, quality-led site execution and contractor coordination.']
];
---
<BaseLayout title="Careers" description="Build your engineering career with SJ Powertech.">
  <PageHero title="Build work that matters." text="Join a team that values technical curiosity, accountability and the satisfaction of a job done right."/>
  <section class="shell grid gap-10 py-20 md:grid-cols-[.8fr_1.2fr]">
    <div class="reveal">
      <p class="eyebrow">Life at SJ</p>
      <h2 class="heading">Grow with meaningful challenges.</h2>
      <p class="text-slate-600">We invest in capable people and give them the trust, tools and exposure to make a real difference.</p>
      <a href="mailto:hr@sjpowertech.in?subject=SJ%20Powertech%20Career%20Application" class="btn btn-gold mt-5">Send your CV →</a>
    </div>
    <div class="space-y-4">
      {roles.map(([title, meta, text]) => <article class="reveal border border-slate-200 bg-white p-6">
        <div class="flex flex-wrap justify-between gap-3"><div><h3 class="font-display text-2xl text-navy">{title}</h3><p class="m-0 text-sm text-gold">{meta}</p></div><a class="text-sm font-bold text-navy hover:text-gold" href="mailto:hr@sjpowertech.in?subject=SJ%20Powertech%20Career%20Application">Apply →</a></div>
        <p class="mt-3 text-sm text-slate-600">{text}</p>
      </article>)}
    </div>
  </section>
</BaseLayout>
