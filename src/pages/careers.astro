---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const jobs = [
  { count: '2 openings', title: 'Site Supervisors', summary: 'Lead teams delivering safe, efficient power distribution work across active project sites.', responsibilities: ['Manage work crews and daily site activities', 'Ensure safety procedures, work quality and timely execution', 'Coordinate with project stakeholders and maintain site records'], skills: 'Team leadership, site supervision and power distribution experience.' },
  { count: '20 openings', title: 'Linemen', summary: 'Support installation and maintenance activities for distribution transformer and metering projects.', responsibilities: ['Carry out field installation and technical work', 'Perform pole climbing and line-related activities safely', 'Assist with DT meter installation and project commissioning'], skills: 'Technical field experience, pole climbing and DT meter installation knowledge.' },
  { count: '20 openings', title: 'Helpers', summary: 'Provide essential on-site support to technical teams throughout project delivery.', responsibilities: ['Assist linemen and supervisors with site tasks', 'Help organise tools, materials and work areas', 'Follow safety instructions and support daily operations'], skills: 'Physical fitness, reliability and willingness to work in field conditions.' }
];
---
<BaseLayout title="Careers" description="Current power distribution project vacancies at SJ Powertech in Aligarh and Kasganj.">
  <PageHero title="Build power infrastructure with us." text="We are hiring for power distribution projects in Aligarh and Kasganj."/>
  <section class="shell grid gap-10 py-16 lg:grid-cols-[.85fr_1.15fr] lg:py-20">
    <aside class="reveal"><img src="/images/hiring-aligarh-kasganj.jpeg" alt="SJ Powertech hiring for Aligarh and Kasganj" class="w-full border border-slate-200 shadow-md" loading="lazy"/><div class="mt-6 bg-navy p-7 text-white"><p class="eyebrow">Apply now</p><h2 class="mt-2 font-display text-3xl">Power distribution projects</h2><p class="mt-3 text-white/75">Work location: Aligarh and Kasganj, Uttar Pradesh.</p><a href="https://wa.me/918512034223?text=Hello%20SJ%20Powertech%2C%20I%20want%20to%20apply%20for%20the%20power%20distribution%20project." target="_blank" rel="noreferrer" class="btn btn-gold mt-5">Apply on WhatsApp →</a><p class="mt-4 text-sm text-white/70">WhatsApp: +91 85120 34223</p></div></aside>
    <div><p class="eyebrow">Open positions</p><h1 class="heading">Join our field team.</h1><p class="max-w-2xl text-slate-600">SJ Powertech is recruiting skilled and motivated people for field-based power distribution work. Explore the current openings below and apply directly on WhatsApp.</p><div class="mt-8 space-y-5">{jobs.map((job) => <article class="reveal border border-slate-200 bg-white p-6 shadow-sm"><div class="flex flex-wrap items-start justify-between gap-3"><div><p class="text-sm font-bold uppercase tracking-widest text-gold">{job.count}</p><h2 class="mt-1 font-display text-3xl text-navy">{job.title}</h2></div><a href={`https://wa.me/918512034223?text=${encodeURIComponent(`Hello SJ Powertech, I want to apply for the ${job.title} position.`)}`} target="_blank" rel="noreferrer" class="text-sm font-bold text-navy hover:text-gold">Apply →</a></div><p class="mt-3 text-slate-600">{job.summary}</p><h3 class="mt-5 font-bold text-navy">Key responsibilities</h3><ul class="mt-2 space-y-1 pl-5 text-sm text-slate-600">{job.responsibilities.map((item) => <li>{item}</li>)}</ul><p class="mt-4 border-l-2 border-gold pl-3 text-sm text-slate-700"><b>Skills:</b> {job.skills}</p></article>)}</div></div>
  </section>
</BaseLayout>
