---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro';
---
<BaseLayout title="Industries" description="Engineering solutions for manufacturing, infrastructure, energy and commercial sectors."><PageHero title="Built for the demands of your industry." text="Sector understanding makes every engineering decision stronger."/><section class="shell py-20"><div class="grid gap-5 md:grid-cols-2">{[['Manufacturing','Reliable systems that protect production, uptime and product quality.'],['Infrastructure','Coordinated technical delivery for complex and essential environments.'],['Energy & Utilities','Resilient electrical infrastructure engineered for continuity.'],['Commercial & Real Estate','Safe, efficient systems that support exceptional places.'],['Water & Process','Automation and controls for precise, stable process performance.'],['Data & Critical Facilities','Designed with the redundancy and discipline that critical operations require.']].map(([t,d],i)=><article class="reveal group min-h-48 border border-slate-200 p-7 transition hover:bg-navy"><span class="text-gold">0{i+1}</span><h2 class="mt-4 font-display text-2xl text-navy group-hover:text-white">{t}</h2><p class="mt-3 text-sm text-slate-600 group-hover:text-white/70">{d}</p></article>)}</div></section></BaseLayout>
