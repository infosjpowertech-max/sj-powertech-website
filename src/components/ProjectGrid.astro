---
const projects = [
 ['Industrial Power Distribution','Manufacturing','Engineered a safe, scalable power distribution solution.','/images/project-1.png'],
 ['Automated Process Line','Automation','Integrated controls that improved visibility and throughput.','/images/project-2.png'],
 ['Commercial Infrastructure','EPC','Delivered coordinated MEP and electrical infrastructure.','/images/project-3.png'],
 ['Utility Modernization','Energy','Upgraded critical systems for reliability and efficiency.','/images/project-4.png']
];
---
<div class="grid gap-5 sm:grid-cols-2">{projects.map(([name,type,desc,image]) => <article class="reveal group overflow-hidden bg-navy"><div class="h-56 overflow-hidden"><img src={image} alt={`${name} project`} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy"/></div><div class="p-6 text-white"><p class="eyebrow">{type}</p><h3 class="mt-1 font-display text-2xl">{name}</h3><p class="mt-2 text-sm text-white/65">{desc}</p></div></article>)}</div>
