---
import '../styles/global.css'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro';
interface Props { title: string; description?: string; image?: string; }
const { title, description = 'SJ Powertech Pvt. Ltd. provides electrical contracting, smart metering, power infrastructure and skilled manpower solutions in Agra, Uttar Pradesh.', image = '/images/hero.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | SJ Powertech Pvt. Ltd.</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/png" sizes="180x180" href="/favicon.png"/><link rel="apple-touch-icon" href="/favicon.png"/><meta name="google-site-verification" content="IS3wnZ2WGGW1VZ-L2V3eSdpiY1RlLGnp--MgWMzI85o"/><meta property="og:type" content="website"/><meta property="og:title" content={`${title} | SJ Powertech Pvt. Ltd.`}/><meta property="og:description" content={description}/><meta property="og:image" content={new URL(image, Astro.site)}/><meta name="theme-color" content="#0B2344"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Organization',name:'SJ Powertech Pvt. Ltd.',url:Astro.site?.toString(),email:'info@sjpowertech.in',telephone:'+91 88811 40085'})}/></head><body><Header currentPath={Astro.url.pathname}/><main><slot /></main><Footer/><script>
import { gsap } from 'gsap'; const items=document.querySelectorAll('.reveal'); if(items.length) gsap.to(items,{opacity:1,y:0,stagger:.12,duration:.7,ease:'power2.out',scrollTrigger: undefined});
</script></body></html>
